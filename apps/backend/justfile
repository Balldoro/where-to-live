# List available recipes
default:
    @just --list

# Run the dev server with reload
dev:
    uv run fastapi dev src/app/main.py

# Format code
format:
    uv run ruff format .

# Check formatting without changing files
format-check:
    uv run ruff format --check .

# Lint code
lint:
    uv run ruff check .

# Type check
typecheck:
    uv run ty check

# Run tests
test *args:
    uv run pytest {{args}}

# Run all checks (CI-style: format check, lint, types, tests)
check: format-check lint typecheck test
